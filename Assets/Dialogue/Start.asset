%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6bb44663cb28f974caeb1cea7c51418a, type: 3}
  m_Name: Start
  m_EditorClassIdentifier: 
  dialogues:
  - sentence: "\uB2E4\uB4E4 \uC870\uC6A9."
    leftSprite: {fileID: 21300000, guid: 7110d0dc7f1b5f64e9745a69447d0e07, type: 3}
    rightSprite: {fileID: 21300000, guid: b473d6635a5c6064caa2695410435196, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uC2E0\uB3C4\uB4E4\uC774\uC5EC. \uC6B0\uB9AC\uB294 \uC704\uB300\uD55C
      \uB300\uC758\uC2DD\uC744 \uCE58\uB8E8\uAE30 \uC704\uD558\uC5EC \uC624\uB79C
      \uC2DC\uAC04\uC744 \uC368 \uC654\uC2B5\uB2C8\uB2E4. \uB4DC\uB514\uC5B4 \uC624\uB298!"
    leftSprite: {fileID: 21300000, guid: 7110d0dc7f1b5f64e9745a69447d0e07, type: 3}
    rightSprite: {fileID: 21300000, guid: b473d6635a5c6064caa2695410435196, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uADF8 \uCCAB\uAC78\uC74C\uC744 \uB5C4 \uC218 \uC788\uB294 \uC18C\uD658
      \uC758\uC2DD\uC774 \uC774\uB8E8\uC5B4\uC9C8 \uAC81\uB2C8\uB2E4."
    leftSprite: {fileID: 21300000, guid: 7110d0dc7f1b5f64e9745a69447d0e07, type: 3}
    rightSprite: {fileID: 21300000, guid: b473d6635a5c6064caa2695410435196, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uC6B0\uB9AC\uC758 \uCDA9\uC9C1\uD55C \uC608\uC5B8\uAC00 \u2018\uB77C\uC988\u2019\uAC00
      \uC624\uB298 \uD0DC\uC5B4\uB098\uAC8C \uB420 \uAC81\uB2C8\uB2E4!"
    leftSprite: {fileID: 21300000, guid: 7110d0dc7f1b5f64e9745a69447d0e07, type: 3}
    rightSprite: {fileID: 21300000, guid: b473d6635a5c6064caa2695410435196, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uADF8\uB7FC \uC2DC\uC791\uD558\uC9C0."
    leftSprite: {fileID: 21300000, guid: 7110d0dc7f1b5f64e9745a69447d0e07, type: 3}
    rightSprite: {fileID: 21300000, guid: b473d6635a5c6064caa2695410435196, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uB3C4\uC800\uD788 \uC778\uAC04\uC758 \uC5B8\uC5B4\uB77C\uACE4 \uD560
      \uC218 \uC5C6\uB294 \uC774\uACC4\uC758 \uB9D0\uC744 \uC74A\uAE30 \uC2DC\uC791\uD55C\uB2E4.
      \uADF8 \uB0A8\uC131\uC744 \uC8FC\uCCB4\uB85C \uD558\uC5EC \uC2E0\uB3C4\uB4E4\uC774
      \uC8FC\uBB38\uC744 \uB530\uB77C \uC678\uC6B0\uC790 \uC18C\uD658\uC9C4\uC774
      \uBD89\uAC8C \uBE5B\uB09C\uB2E4."
    leftSprite: {fileID: 21300000, guid: 7110d0dc7f1b5f64e9745a69447d0e07, type: 3}
    rightSprite: {fileID: 21300000, guid: 7110d0dc7f1b5f64e9745a69447d0e07, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 1
  - sentence: "\uC18C\uB140\uB294 \uADF8 \uC5B4\uB5A4 \uB5A8\uB9BC\uB3C4 \uB450\uB824\uC6C0\uB3C4
      \uB290\uAEF4\uC9C0\uC9C0 \uC54A\uB294 \uC5BC\uAD74\uB85C \uC11C \uC788\uC744
      \uBFD0\uC774\uC5C8\uB2E4."
    leftSprite: {fileID: 21300000, guid: 7110d0dc7f1b5f64e9745a69447d0e07, type: 3}
    rightSprite: {fileID: 21300000, guid: 7110d0dc7f1b5f64e9745a69447d0e07, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 1
  - sentence: "\uB4DC\uB514\uC5B4 \uC131\uACF5\uD588\uB2E4! \uB77C\uC988! \uAE30\uBD84\uC740
      \uC5B4\uB5A0\uB0D0!"
    leftSprite: {fileID: 21300000, guid: 864af748372a4bd4db9af901177f1823, type: 3}
    rightSprite: {fileID: 21300000, guid: b473d6635a5c6064caa2695410435196, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "... .... \uBB34\uCC99... \uC5B4\uC9C0\uB7EC\uC6CC\uC694."
    leftSprite: {fileID: 21300000, guid: 864af748372a4bd4db9af901177f1823, type: 3}
    rightSprite: {fileID: 21300000, guid: b473d6635a5c6064caa2695410435196, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uADF8\uB798, \uC545\uB9C8\uAC00 \uBAB8\uC5D0 \uAE43\uB4E4\uC5C8\uB2E4\uB294
      \uC99D\uAC70\uB2E4. \uB10C \uC55E\uC73C\uB85C \uADF8 \uD798\uC744 \uC368 \uB9CE\uC740
      \uC77C\uC744 \uD558\uAC8C \uB420 \uAC70\uC57C. \uD2B9\uD788 \uB300\uC758\uC2DD\uC744
      \uC704\uD574\uC11C \uB9D0\uC774\uC9C0."
    leftSprite: {fileID: 21300000, guid: 864af748372a4bd4db9af901177f1823, type: 3}
    rightSprite: {fileID: 21300000, guid: b473d6635a5c6064caa2695410435196, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uC2E0\uB3C4\uB4E4\uC774\uC5EC, \uBCF4\uC558\uC2B5\uB2C8\uAE4C? \uC6B0\uB9AC\uC758
      \uCCAB \uC2DC\uC791\uC774 \uC21C\uD0C4\uD558\uAC8C \uB9C9\uC744 \uC774\uB8E8\uC5C8\uC2B5\uB2C8\uB2E4!"
    leftSprite: {fileID: 21300000, guid: 864af748372a4bd4db9af901177f1823, type: 3}
    rightSprite: {fileID: 21300000, guid: b473d6635a5c6064caa2695410435196, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uADF8\uB798, \uC55E\uC73C\uB85C\uAC00 \uB354 \uC911\uC694\uD574.
      \uC55E\uC73C\uB85C\uAC00...."
    leftSprite: {fileID: 21300000, guid: 7110d0dc7f1b5f64e9745a69447d0e07, type: 3}
    rightSprite: {fileID: 21300000, guid: b473d6635a5c6064caa2695410435196, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4. \uB77C\uC988 \uC544\uAC00\uC528."
    leftSprite: {fileID: 21300000, guid: 864af748372a4bd4db9af901177f1823, type: 3}
    rightSprite: {fileID: 21300000, guid: 4cb6fc3607cbc6f40a931fd6618a80c1, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uC9D1\uC0AC \uB2D8. \uC544\uB2C8\uC5D0\uC694. \uC81C\uAC00 \uB9C8\uB545\uD788
      \uD574\uC57C\uD558\uB294 \uC77C\uC778 \uAC78\uC694."
    leftSprite: {fileID: 21300000, guid: 864af748372a4bd4db9af901177f1823, type: 3}
    rightSprite: {fileID: 21300000, guid: 4cb6fc3607cbc6f40a931fd6618a80c1, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uC544\uB2D9\uB2C8\uB2E4. \uC18C\uD658 \uC758\uC2DD\uC740 \uC544\uBB34\uB098
      \uD558\uB294 \uC77C\uC774 \uC544\uB2C8\uB2C8\uAE4C\uC694. \uC790. \uC5B4\uC11C
      \uBC29\uC73C\uB85C \uAC00\uC2DC\uC8E0. \uC2DC\uAC04\uC774 \uB2A6\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB0B4\uC77C \uC77C\uC815\uC744 \uC18C\uD654\uD558\uC2DC\uB824\uBA74 \uC8FC\uBB34\uC154\uC57C
      \uD574\uC694."
    leftSprite: {fileID: 21300000, guid: 864af748372a4bd4db9af901177f1823, type: 3}
    rightSprite: {fileID: 21300000, guid: 4cb6fc3607cbc6f40a931fd6618a80c1, type: 3}
    hasChoices: 0
    choices: []
    systemName: 
    isNarration: 0
  - sentence: "\uB124!"
    leftSprite: {fileID: 21300000, guid: 864af748372a4bd4db9af901177f1823, type: 3}
    rightSprite: {fileID: 21300000, guid: 4cb6fc3607cbc6f40a931fd6618a80c1, type: 3}
    hasChoices: 0
    choices: []
    systemName: FadeIn
    isNarration: 0
